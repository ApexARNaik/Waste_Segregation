# Smart Waste Segregation Environment Configuration
# Copy this file to .env and configure appropriate values.

# Admin Authentication
ADMIN_PASSWORD=change_this_to_a_secure_admin_password
SESSION_SECRET=generate_a_random_secret_e.g_python_secrets_token_hex_32

# Database & Session Configuration
DB_PATH=data/waste_segregation.db
SESSION_TTL_SECONDS=28800

# Camera Hardware Configuration (USB Serial)
CAMERA_PORT=COM9
CAMERA_BAUD=921600

# Sensor & Hardware Triggering
CAMERA_TRIGGER=ir
# Unconfirmed hardware pin: verify and confirm actual GPIO on ESP32-CAM before enabling
IR_SENSOR_PIN=UNCONFIRMED_GPIO
CAPTURE_INTERVAL_SECONDS=5

# Camera Chute Cropping Coordinates (LEFT, TOP, RIGHT, BOTTOM)
CROP_LEFT=45
CROP_TOP=0
CROP_RIGHT=610
CROP_BOTTOM=480

# Local YOLO Vision Model
MODEL_PATH=models/waste_models.pt
MODEL_CONFIDENCE=0.25
